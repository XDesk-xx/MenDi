{
  "name": "mendi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "bin": {
    "mendi": "dist/drivers/cli.js"
  },
  "files": [
    "dist/",
    "skills/",
    "README.md"
  ],
  "scripts": {
    "format": "biome format --write src scripts tests",
    "format:check": "biome format src scripts tests",
    "lint": "biome lint src scripts tests",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json && tsc -p tsconfig.tests.json",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test": "pnpm build && node --test --test-concurrency=2 tests/*.test.ts",
    "build": "tsc",
    "start": "node dist/drivers/cli.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "yaml": "2.9.1"
  }
}

    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "2.6.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "3.3.13",
    "@storybook/vue3-vite": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "storybook": "10.6.1",

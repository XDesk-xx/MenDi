{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "src/**/*.ts",
      "scripts/**/*.ts",
      "tests/*.ts",
      "tests/ui/**/*.ts",
      "tests/installation/**/*.ts",
      "tests/fixtures/storybook-project/**/*.ts",
      "tests/fixtures/d03-b-project/**/*.ts",
      "tests/fixtures/group-*.ts",
      "tests/fixtures/legacy-*.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "assist": { "enabled": false },
  "linter": {
    "rules": {
      "recommended": false,
      "correctness": { "noUnreachable": "error", "noUnusedImports": "error" },
      "suspicious": {
        "noDebugger": "error",
        "noDoubleEquals": "error",
        "noDuplicateObjectKeys": "error"
      }
    }
  }
}
